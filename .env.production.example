# 复制为部署节点外部的受控环境文件。禁止提交真实密码、令牌和密钥。
GUANSEQ_VERSION=0.1.0-alpha.1
GUANSEQ_WEB_IMAGE=guanseq/web
GUANSEQ_SERVER_IMAGE=guanseq/server

# 默认只监听宿主回环地址，由已有 TLS 反向代理转发到该端口。
GUANSEQ_PUBLIC_ORIGIN=https://guanseq.example.com
GUANSEQ_HTTP_BIND_ADDRESS=127.0.0.1
GUANSEQ_HTTP_PORT=3000
GUANSEQ_TLS_TERMINATION_CONFIRMED=true
# 仅供预检描述 BFF 内部目标；生产 Compose 会固定为 http://server:8080。
GUANSEQ_API_BASE_URL=http://server:8080

GUANSEQ_POSTGRES_DB=guanseq
GUANSEQ_POSTGRES_USER=guanseq
GUANSEQ_DB_PASSWORD=replace-with-a-unique-random-database-password
GUANSEQ_POSTGRES_VOLUME=guanseq-postgres-data

GUANSEQ_OIDC_ISSUER_URI=https://identity.example.com/realms/guanseq
GUANSEQ_OIDC_JWK_SET_URI=https://identity.example.com/realms/guanseq/protocol/openid-connect/certs
GUANSEQ_OIDC_AUDIENCE=guanseq-api
GUANSEQ_OIDC_USERNAME_CLAIM=preferred_username
GUANSEQ_OIDC_CLIENT_ID=guanseq-web
GUANSEQ_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret-at-least-24-characters
GUANSEQ_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
GUANSEQ_OIDC_REDIRECT_URI=https://guanseq.example.com/api/auth/callback
GUANSEQ_OIDC_POST_LOGOUT_REDIRECT_URI=https://guanseq.example.com/login?signedOut=1
GUANSEQ_OIDC_SCOPE=openid profile
GUANSEQ_OIDC_RESOURCE=guanseq-api
GUANSEQ_SESSION_SECRET=replace-with-base64-encoded-32-random-bytes

# 只在空正式库初始化窗口临时改为 true；成功后立即恢复 false 并删除令牌。
GUANSEQ_BOOTSTRAP_ENABLED=false
GUANSEQ_BOOTSTRAP_TOKEN=disabled

# 设备采集与清理调度默认关闭，实例完成责任和容量验收后再开启。
GUANSEQ_TELEMETRY_POLLING_ENABLED=false
GUANSEQ_TELEMETRY_RETENTION_SCHEDULER_ENABLED=false

# 备份产物必须写入受控、加密并异机复制的目录。示例目录只用于本地演练。
GUANSEQ_BACKUP_DIRECTORY=backups
GUANSEQ_BACKUP_RETENTION_DAYS=30
GUANSEQ_RPO_HOURS=24
GUANSEQ_RTO_HOURS=4
